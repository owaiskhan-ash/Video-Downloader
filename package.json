{
  "name": "video-downloader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paste a link, get the video in HD (H.264/AAC mp4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
