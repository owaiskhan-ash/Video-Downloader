# --- Downloaded media & yt-dlp temp files ---
downloads/
*.part
*.part-Frag*
*.ytdl
*.tmp

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend build ---
node_modules/
dist/
dist-ssr/
*.local

# --- Rust / Tauri ---
# target/ holds multi-GB build artifacts; never commit these.
src-tauri/target/
target/
# Generated by `tauri build` from tauri.conf.json.
src-tauri/gen/

# --- Android / buildozer ---
# prepare.sh copies engine/ and dist/ into android/ at build time; they are
# derived copies of the sources of truth at the repo root.
android/engine/
android/dist/
android/devserver.py
android/assets/ffmpeg/
android/.buildozer/
android/.build/
android/bin/
*.apk
*.aab

# --- Bundled binaries (fetched by scripts/setup_engine.py) ---
# A static ffmpeg is ~80 MB and a PyInstaller sidecar ~30 MB. Both are
# reproducible from the setup script, so they stay out of git.
resources/bin/
src-tauri/binaries/
bin/ffmpeg
.cache/ffmpeg/

# --- App data ---
*.sqlite
*.sqlite3
data/
settings.json

# --- Secrets ---
# A cookies file is a session credential: anyone holding it can act as you.
.env
.env.*
cookies.txt
*cookies*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
